# Copy to .env for local development (never commit .env)

# Required for live / paper-with-wallet modes
AGENT_PRIVATE_KEY=

# Overtime REST API — gated; hobby projects are typically rejected.
# Not required for Phase 2 detection (uses public subgraph instead).
OVERTIME_API_KEY=

# The Graph gateway key — optional. If unset, uses the public key from Overtime's
# open-source thales-data package (same as the website). Register your own free key
# at https://thegraph.com/studio/ if you hit rate limits.
THEGRAPH_API_KEY=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional RPC overrides (comma-separated fallback per chain in config.yaml)
# BASE_RPC_URL=
# OPTIMISM_RPC_URL=
# ARBITRUM_RPC_URL=

# Runtime mode flags (also set via CLI)
# PAPER_MODE=1
# AGENT_LIVE=1
